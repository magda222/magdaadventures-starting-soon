<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>MagdaAdventures - Próximamente</title>
</head>
<body style="background:black;color:white;font-family:Arial;text-align:center;padding-top:100px;">

  <h1>MAGDAADVENTURES</h1>
  <h2>STREAM INICIANDO</h2>
  
  <!-- Le pusimos id="temporizador" para que el script sepa dónde poner los números -->
  <h1 id="temporizador">05:00</h1>

  <script>
    let tiempo = 300; // 5 minutos en segundos

    setInterval(() => {
      let m = Math.floor(tiempo / 60);
      let s = tiempo % 60;

      document.getElementById("temporizador").innerHTML = 
        String(m).padStart(2, "0") + ":" + String(s).padStart(2, "0");

      if (tiempo > 0) {
        tiempo--;
      }
    }, 1000);
  </script>

</body>
</html>
